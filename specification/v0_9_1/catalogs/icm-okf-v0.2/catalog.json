{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a2ui.org/specification/v0_9_1/catalogs/icm-okf-v0.2/catalog.json",
  "title": "ICM + OKF v0.2 Two-Tier A2UI Component Catalog",
  "description": "Two-tier A2UI v0.9.1 catalog extending the upstream Basic Catalog with ICM + OKF v0.2 domain components (OkfMarkdown, OkfKnowledgeGraph, InteractiveChecklist, ModuleCarousel, QuizRunner, CaseSimulator) and Badge status primitives.",
  "catalogId": "https://a2ui.org/specification/v0_9_1/catalogs/icm-okf-v0.2/catalog.json",
  "extendsCatalogId": "https://a2ui.org/specification/v0_9_1/catalogs/basic/catalog.json",
  "version": "v0.9.1",
  "components": {
    "Badge": {
      "type": "object",
      "allOf": [
        {
          "$ref": "../../json/common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "Badge"
            },
            "text": {
              "$ref": "../../json/common_types.json#/$defs/DynamicString",
              "description": "The text label rendered inside the pill badge (e.g. status: stable, trust: human-reviewed, fresh)."
            },
            "tone": {
              "type": "string",
              "description": "Semantic visual tone for the status badge.",
              "enum": ["primary", "success", "warn", "danger", "accent", "neutral"],
              "default": "neutral"
            }
          },
          "required": ["component", "text"]
        }
      ],
      "unevaluatedProperties": false
    },
    "OkfMarkdown": {
      "type": "object",
      "allOf": [
        {
          "$ref": "../../json/common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "OkfMarkdown"
            },
            "title": {
              "$ref": "../../json/common_types.json#/$defs/DynamicString",
              "description": "Title of the OKF v0.2 concept document."
            },
            "body": {
              "$ref": "../../json/common_types.json#/$defs/DynamicString",
              "description": "OKF v0.2 Markdown body with inline [^id] footnote citations and bottom [^id]: Title definitions."
            },
            "frontmatter": {
              "type": "object",
              "description": "Optional raw OKF v0.2 YAML frontmatter object or JSON Pointer binding."
            },
            "sources": {
              "description": "Array of OKF v0.2 source objects ({ id, title, resource, retrieved_at, last_modified }) or JSON Pointer binding.",
              "oneOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                {
                  "$ref": "../../json/common_types.json#/$defs/DataBinding"
                }
              ]
            },
            "trustTier": {
              "$ref": "../../json/common_types.json#/$defs/DynamicString",
              "description": "Computed OKF v0.2 trust tier (unverified | machine-confirmed | human-reviewed)."
            },
            "isStale": {
              "$ref": "../../json/common_types.json#/$defs/DynamicBoolean",
              "description": "Computed OKF v0.2 staleness flag evaluated against frontmatter.stale_after."
            },
            "editablePath": {
              "type": "string",
              "description": "RFC 6901 JSON Pointer path for Layer 4 in-place Markdown editing (defaults to /okf/body)."
            },
            "rejectedSourcesPath": {
              "type": "string",
              "description": "RFC 6901 JSON Pointer path storing interactive rejected source IDs (defaults to /okf/rejectedSources)."
            },
            "addedSourcesPath": {
              "type": "string",
              "description": "RFC 6901 JSON Pointer path storing interactive human-added sources (defaults to /okf/addedSources)."
            },
            "verifierActorPath": {
              "type": "string",
              "description": "RFC 6901 JSON Pointer path storing the human verifier identity (defaults to /okf/verifierActor)."
            }
          },
          "required": ["component", "body"]
        }
      ],
      "unevaluatedProperties": false
    },
    "OkfKnowledgeGraph": {
      "type": "object",
      "allOf": [
        {
          "$ref": "../../json/common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "OkfKnowledgeGraph"
            },
            "title": {
              "$ref": "../../json/common_types.json#/$defs/DynamicString",
              "description": "Header title for the embedded Cytoscape.js OKF v0.2 knowledge graph explorer."
            },
            "bundlePath": {
              "type": "string",
              "description": "Optional relative path to the standalone workspace/bundle/viz.html graph explorer."
            }
          },
          "required": ["component"]
        }
      ],
      "unevaluatedProperties": false
    },
    "InteractiveChecklist": {
      "type": "object",
      "allOf": [
        {
          "$ref": "../../json/common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "InteractiveChecklist"
            },
            "title": {
              "$ref": "../../json/common_types.json#/$defs/DynamicString",
              "description": "Header title for the interactive checklist card."
            },
            "subtitle": {
              "$ref": "../../json/common_types.json#/$defs/DynamicString",
              "description": "Optional subtitle or completion summary binding."
            },
            "groupsPath": {
              "type": "string",
              "description": "RFC 6901 JSON Pointer path to the checklist groups array in the surface data model (e.g. /checklist/groups)."
            }
          },
          "required": ["component", "groupsPath"]
        }
      ],
      "unevaluatedProperties": false
    },
    "ModuleCarousel": {
      "type": "object",
      "allOf": [
        {
          "$ref": "../../json/common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "ModuleCarousel"
            },
            "title": {
              "$ref": "../../json/common_types.json#/$defs/DynamicString",
              "description": "Header title for the training modules or analytical pillars carousel."
            },
            "modulesPath": {
              "type": "string",
              "description": "RFC 6901 JSON Pointer path to the normalized Stage 2 modules/pillars array (e.g. /stage2/modules)."
            },
            "activeIndexPath": {
              "type": "string",
              "description": "RFC 6901 JSON Pointer path to the currently active module index (e.g. /stage2/activeModuleIndex)."
            }
          },
          "required": ["component", "modulesPath"]
        }
      ],
      "unevaluatedProperties": false
    },
    "QuizRunner": {
      "type": "object",
      "allOf": [
        {
          "$ref": "../../json/common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "QuizRunner"
            },
            "title": {
              "$ref": "../../json/common_types.json#/$defs/DynamicString",
              "description": "Header title for the interactive knowledge check runner."
            },
            "questionsPath": {
              "type": "string",
              "description": "RFC 6901 JSON Pointer path to the quiz questions array (e.g. /stage2/quiz)."
            },
            "answersPath": {
              "type": "string",
              "description": "RFC 6901 JSON Pointer path to the user's selected quiz answers map (e.g. /stage2/quizAnswers)."
            }
          },
          "required": ["component", "questionsPath"]
        }
      ],
      "unevaluatedProperties": false
    },
    "CaseSimulator": {
      "type": "object",
      "allOf": [
        {
          "$ref": "../../json/common_types.json#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/CatalogComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "CaseSimulator"
            },
            "title": {
              "$ref": "../../json/common_types.json#/$defs/DynamicString",
              "description": "Header title for the interactive scenario, dilemma, or stress-test simulator."
            },
            "casesPath": {
              "type": "string",
              "description": "RFC 6901 JSON Pointer path to the normalized cases/scenarios array (e.g. /stage2/cases)."
            },
            "responsesPath": {
              "type": "string",
              "description": "RFC 6901 JSON Pointer path to the user's drafted scenario responses map (e.g. /stage2/caseResponses)."
            }
          },
          "required": ["component", "casesPath"]
        }
      ],
      "unevaluatedProperties": false
    }
  },
  "$defs": {
    "CatalogComponentCommon": {
      "type": "object",
      "properties": {
        "weight": {
          "type": "number",
          "description": "The relative flex-grow weight of this component when placed inside a Row or Column."
        }
      }
    },
    "anyComponent": {
      "oneOf": [
        { "$ref": "../basic/catalog.json#/components/Text" },
        { "$ref": "../basic/catalog.json#/components/Image" },
        { "$ref": "../basic/catalog.json#/components/Icon" },
        { "$ref": "../basic/catalog.json#/components/Video" },
        { "$ref": "../basic/catalog.json#/components/AudioPlayer" },
        { "$ref": "../basic/catalog.json#/components/Row" },
        { "$ref": "../basic/catalog.json#/components/Column" },
        { "$ref": "../basic/catalog.json#/components/List" },
        { "$ref": "../basic/catalog.json#/components/Card" },
        { "$ref": "../basic/catalog.json#/components/Tabs" },
        { "$ref": "../basic/catalog.json#/components/Modal" },
        { "$ref": "../basic/catalog.json#/components/Divider" },
        { "$ref": "../basic/catalog.json#/components/Button" },
        { "$ref": "../basic/catalog.json#/components/TextField" },
        { "$ref": "../basic/catalog.json#/components/CheckBox" },
        { "$ref": "../basic/catalog.json#/components/ChoicePicker" },
        { "$ref": "../basic/catalog.json#/components/Slider" },
        { "$ref": "../basic/catalog.json#/components/DateTimeInput" },
        { "$ref": "#/components/Badge" },
        { "$ref": "#/components/OkfMarkdown" },
        { "$ref": "#/components/OkfKnowledgeGraph" },
        { "$ref": "#/components/InteractiveChecklist" },
        { "$ref": "#/components/ModuleCarousel" },
        { "$ref": "#/components/QuizRunner" },
        { "$ref": "#/components/CaseSimulator" }
      ],
      "discriminator": {
        "propertyName": "component"
      }
    }
  }
}
