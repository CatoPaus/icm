{
  "name": "genkit-icm-environment",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "genkit:dev": "node --env-file=.env.local node_modules/genkit-cli/dist/bin/genkit.js start -- npx tsx --watch-path=src --watch-path=prompts src/server.ts",
    "dev:all": "npm run genkit:dev",
    "server": "npx tsx --env-file=.env.local src/server.ts",
    "clean": "node scripts/cleanup.js"
  },
  "dependencies": {
    "@genkit-ai/google-genai": "^1.43.0",
    "@genkit-ai/middleware": "^0.11.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "genkit": "^1.43.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "genkit-cli": "^1.44.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
