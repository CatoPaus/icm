{
  "name": "open-knowledge-studio",
  "version": "2.0.0",
  "description": "Zero-dependency grounded research, compounding OKF v0.2 knowledge graphs, and interactive A2UI v0.9.1 surfaces powered by Interpretable Context Methodology (ICM).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "cli": "npx tsx --env-file-if-exists=.env.local src/index.ts --cli",
    "cli:stage1": "npx tsx --env-file-if-exists=.env.local src/index.ts --stage1",
    "cli:stage2": "npx tsx --env-file-if-exists=.env.local src/index.ts --stage2",
    "cli:verify": "npx tsx --env-file-if-exists=.env.local src/index.ts --verify",
    "cli:viz": "npx tsx --env-file-if-exists=.env.local src/index.ts --viz",
    "cli:a2ui": "npx tsx --env-file-if-exists=.env.local src/index.ts --a2ui",
    "cli:ping-pong": "npx tsx --env-file-if-exists=.env.local src/index.ts --ping-pong",
    "test": "npx tsx src/index.ts --test",
    "typecheck": "npx tsc --noEmit",
    "clean": "node scripts/cleanup.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
